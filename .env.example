# Copy to .env.local and fill in. .env.local is gitignored; never commit it.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/ETL only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: for CLI migrations (Project Settings > Database)
SUPABASE_DB_URL=

# --- GitHub (fine-grained token, Contents: read/write on the one repo) ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- Vercel (only if using the CLI; the Vercel MCP uses its own login) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
